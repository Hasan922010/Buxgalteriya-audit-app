# Environment Configuration Template for Yordamchi Buxgalter AI
PROJECT_NAME="Yordamchi Buxgalter AI"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yordamchi_buxgalter

DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/yordamchi_buxgalter"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:your_password@localhost:5432/yordamchi_buxgalter"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Provider Keys
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Security (required: the backend refuses to start without a >= 32 char random SECRET_KEY)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# First administrator: created on startup only while the users table is empty.
# Alternatively: python -m app.core.create_user admin --superuser
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Logs every SQL statement including data and password hashes; local debugging only
SQL_ECHO=False

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# File storage for uploaded documents and backups (real accounting data; keep out of git)
# UPLOAD_DIR=/var/lib/buxgalter/uploads
# BACKUP_DIR=/var/lib/buxgalter/backups

# Factory reset / organization data wipe endpoints (a backup is written first). Keep False in production.
ALLOW_SYSTEM_RESET=False

# Didox / Soliq adapters only generate SIMULATED documents. Never enable on a real database.
INTEGRATIONS_DEMO_MODE=False
